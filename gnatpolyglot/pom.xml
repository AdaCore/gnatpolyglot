<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.adacore.gnatpolyglot</groupId>
  <artifactId>gnatpolyglot</artifactId>
  <packaging>pom</packaging>
  <version>0.1.0</version>
  <modules>
    <module>cli</module>
    <module>proxy</module>
    <module>ada2proxy</module>
    <module>proxy2cpp</module>
    <module>proxy2java</module>
    <module>proxy2rust</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <!--
      Maven Surefire does not provide a CLI argument to choose the reportsDirectory.
      To configure this, change the value of this property (-Dmaven.surefire.reportsDirectory=...)
    -->
    <maven.surefire.reportsDirectory>
      ${project.build.directory}/surefire-reports
    </maven.surefire.reportsDirectory>

    <config.jte.version>3.1.16</config.jte.version>

    <config.libadalang.version>0.1</config.libadalang.version>

    <config.python>python</config.python>

    <config.skipNativeBuild>true</config.skipNativeBuild>

    <config.buildMode>dev</config.buildMode>
  </properties>

  <profiles>
    <profile>
      <id>native</id>
      <properties>
        <config.skipNativeBuild>false</config.skipNativeBuild>
      </properties>
    </profile>

    <profile>
      <id>dev</id>
      <properties>
        <config.buildMode>dev</config.buildMode>
      </properties>
    </profile>

    <profile>
      <id>debug</id>
      <properties>
        <config.buildMode>debug</config.buildMode>
      </properties>
    </profile>

    <profile>
      <id>prod</id>
      <properties>
        <config.buildMode>prod</config.buildMode>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>4.7.7</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <reportsDirectory>${maven.surefire.reportsDirectory}</reportsDirectory>
        </configuration>
      </plugin>

      <!-- Configure the Java compiler -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>24</release>
          <showWarnings>true</showWarnings>
        </configuration>
      </plugin>

      <!-- Configure the spotless Java formatter -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.40.0</version>

        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>

        <configuration>
          <java>
            <includes>
              <include>cli/src/*/java/**/*.java</include>
              <include>proxy/src/*/java/**/*.java</include>
              <include>ada2proxy/src/*/java/**/*.java</include>
              <include>proxy2cpp/src/*/java/**/*.java</include>
              <include>proxy2java/src/*/java/**/*.java</include>
              <include>proxy2rust/src/*/java/**/*.java</include>
            </includes>

            <googleJavaFormat>
              <version>1.17.0</version>
              <style>AOSP</style>
              <reflowLongStrings>true</reflowLongStrings>
              <formatJavadoc>true</formatJavadoc>
            </googleJavaFormat>

            <importOrder>
              <wildcardsLast>true</wildcardsLast>
              <semanticSort>true</semanticSort>
            </importOrder>
            <formatAnnotations/>
            <removeUnusedImports/>
          </java>
          <lineEndings>UNIX</lineEndings>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
