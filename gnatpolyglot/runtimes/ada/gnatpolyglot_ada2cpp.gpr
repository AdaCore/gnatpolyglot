library project GNATpolyglot_Ada2Cpp is

   type Build_Mode_Type is ("dev", "prod");
   Build_Mode : Build_Mode_Type := external
     ("GNATPOLYGLOT_ADA2CPP_BUILD_MODE", external ("BUILD_MODE", "dev"));

   type Library_Kind_Type is ("static", "relocatable", "static-pic");
   Library_Kind : Library_Kind_Type := external
     ("GNATPOLYGLOT_ADA2CPP_LIBRARY_KIND", external ("LIBRARY_KIND", "static"));

   for Languages use ("C++");

   for Source_Dirs use ("src2cpp");
   for Object_Dir use "obj" & "/" & Build_Mode;

   for Library_Name use "gnatpolyglotada2cpp";
   for Library_Dir use "lib2cpp/" & Library_Kind & "/" & Build_Mode;

   package Compiler is
      case Build_Mode is
         when "dev" =>
            for Switches ("C++") use ("-g", "-O0");
         when "prod" =>
            for Switches ("C++") use ("-Ofast");
      end case;
   end Compiler;

   package Naming is
      for Spec_Suffix ("C++") use ".h";
      for Body_Suffix ("C++") use ".cpp";
   end Naming;

end GNATpolyglot_Ada2Cpp;
