with "../gnatpolyglot/gnatpolyglot.gpr";

library project GNATpolyglot.Ada is

   type Build_Mode_Type is ("dev", "prod");
   Build_Mode : Build_Mode_Type := external
     ("GNATPOLYGLOT_ADA_BUILD_MODE", external ("BUILD_MODE", "dev"));

   type Library_Kind_Type is ("static", "relocatable", "static-pic");
   Library_Kind : Library_Kind_Type := external
     ("GNATPOLYGLOT_ADA_LIBRARY_KIND", external ("LIBRARY_KIND", "static"));

   for Languages use ("Ada");

   for Source_Dirs use ("src");
   for Object_Dir use "obj" & "/" & Build_Mode;

   for Library_Name use "gnatpolyglotada";
   for Library_Dir use "lib/" & Library_Kind & "/" & Build_Mode;
   for Library_Kind use Library_Kind;

   package Compiler is
      case Build_Mode is
         when "dev" =>
            for Switches ("Ada") use ("-g", "-O0");
         when "prod" =>
            for Switches ("Ada") use ("-Ofast");
      end case;
   end Compiler;

end GNATpolyglot.Ada;
