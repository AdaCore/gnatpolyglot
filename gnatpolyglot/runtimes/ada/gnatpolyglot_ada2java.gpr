library project GNATpolyglot_Ada2Java is

   type Build_Mode_Type is ("dev", "prod");
   Build_Mode : Build_Mode_Type := external
     ("GNATPOLYGLOT_ADA2JAVA_BUILD_MODE", external ("BUILD_MODE", "dev"));

   for Languages use ("C");

   for Source_Dirs use ("src2java/jni");
   for Object_Dir use "obj" & "/" & Build_Mode;

   type Library_Kind_Type is ("static", "relocatable", "static-pic");
   Library_Kind : Library_Kind_Type := external ("LIBRARY_KIND", "relocatable");

   for Library_Name use "gnatpolyglot_ada2java";
   for Library_Dir use "lib/" & Library_Kind;
   for Library_Kind use Library_Kind;

   Java_Home := external ("JAVA_HOME");
   JNI_Headers := ("-I" & Java_Home & "/include/");

   type OS_Type is ("windows", "unix");
   OS : OS_Type := external ("OS", "unix");

   case OS is
      when "windows" =>
         JNI_Headers := ("-I" & Java_Home & "/include/win32") & JNI_Headers;
         for Shared_Library_Prefix use "";
      when "unix" =>
         JNI_Headers := ("-I" & Java_Home & "/include/linux") & JNI_Headers;
   end case;

   package Compiler is
      case Build_Mode is
         when "dev" =>
            for Switches ("C") use ("-g", "-O0") & JNI_Headers;
         when "prod" =>
            for Switches ("C") use ("-Ofast") & JNI_Headers;
      end case;
   end Compiler;

   Gnatpolyglot_Ada2Proxy_Lib := external
       ("GNATPOLYGLOT_ADA2PROXY_LIB", external ("PROXY_LIB"));
   for Library_Options use ("-l" & Gnatpolyglot_Ada2Proxy_Lib);

   Gnatpolyglot_Ada2Proxy_Lib_Location := external
       ("GNATPOLYGLOT_ADA2PROXY_LIB_LOCATION", external ("PROXY_LIB_LOCATION"));

   package Linker is
      for Linker_Options use ("-L" & Gnatpolyglot_Ada2Proxy_Lib_Location);
   end Linker;

end GNATpolyglot_Ada2Java;
