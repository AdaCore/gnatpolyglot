library project GNATpolyglot is

   for Languages use ("C");

   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   type Library_Kind_Type is ("static", "relocatable", "static-pic");
   Library_Kind : Library_Kind_Type := external ("LIBRARY_KIND", "static");

   for Library_Name use "gnatpolyglot";
   for Library_Dir use "lib/" & Library_Kind;
   for Library_Kind use Library_Kind;

   package Compiler is
      for Switches ("C") use ("-g");
   end Compiler;

end GNATpolyglot;
