SPDX-License-Identifier: GPL-3.0-or-later
Template file to generate a function.
--%>

@import com.adacore.gnatpolyglot.proxy.ClassDecl
@import com.adacore.gnatpolyglot.proxy.ClassDecl.Inheritability
@import com.adacore.gnatpolyglot.proxy.FunctionDecl
@import com.adacore.gnatpolyglot.proxy.VTableEntry
@import com.adacore.gnatpolyglot.proxy2java.JavaAPI
@import java.util.HashMap

@param JavaAPI api
@param ClassDecl classDecl

@if(classDecl.inheritability != Inheritability.FINAL)

!{
    String className = classDecl.getLastName().toPascal();
    String fqn = api.javaTypename(classDecl.name.asTypeExpr());
    String prefix = fqn.replace(".", "__");

    Integer i = 0;
    HashMap<VTableEntry, String> dispatchNames = new HashMap<>();
    for (var m : classDecl.vtable) {
        dispatchNames.put(m, m.name.toLower() + "_dispatch_" + i++);
    }
}

<%-- Structure describing the vtable of the class. The vtable must strictly match
  -- the corresponding struct generated by the Scanner. By default, a vtable should
  -- contain the polymorphic clone function pointer, the freeing function for the
  -- user object (necessary when the library owns the wrapped data and decides to
  -- free it), and a function pointer to free the extraneous data given by the Printer.
  -- The rest of the function are described by the vtable field of the proxy.
  --%>
struct ${className}_vtable {
    void *(*clone_shadow_dispatch)(void *_self_data, jobject _self, void *_data);
    void (*free_shadow_dispatch)(void *_self_data, jobject _self);
    void (*free_data)(jobject _self);
@for(var method : classDecl.vtable)
    ${api.cTypename(method.functionType.returnType)}
    (*${dispatchNames.get(method)})
    (${api.jniUpcallParameters(method.functionType, true)});
@endfor
};
struct ${className}_vtable ${className}_vtable;

@for (var method : classDecl.vtable)

    @template.jni.callback(
        api,
        method.functionType,
        className + "_" + dispatchNames.get(method),
        true,
        classDecl.name,
        "dispatch$" + method.name.toCamel(),
        api.jniSignature(method.functionType, classDecl)
    )

@endfor

void *${className}_do_internal_clone(void *self_data, jobject self, void *data) {
    JavaVM *vm = self_data;
    JNIEnv *env = NULL;
    (*vm)->AttachCurrentThread(vm, (void **)&env, NULL);
    jobject clone = (*env)->NewGlobalRef(
        env,
        (*env)->CallObjectMethod(
            env,
            self,
            PolyglotObject_internal_clone_method(env),
            (jlong) data
        )
    );
    return clone;
}

void ${className}_do_internal_free(void *self_data, jobject self) {
    // If this is called, thats means the destruction of the shadow data was
    // called from the library. The data is already being freed on that side if
    // necessary (it could have been copied on the stack, meaning that calling
    // the free function could lead to an invalid free)
    if (self != NULL) {
        JavaVM *vm = self_data;
        JNIEnv *env = NULL;
        (*vm)->AttachCurrentThread(vm, (void **)&env, NULL);
        (*env)->CallObjectMethod(
            env,
            self,
            PolyglotObject_internal_release_method(env)
        );
        (*env)->DeleteGlobalRef(env, self);
    }
}


struct ${className}_vtable ${className}_vtable = {
    .clone_shadow_dispatch = ${className}_do_internal_clone,
    .free_shadow_dispatch = &${className}_do_internal_free,
    .free_data = NULL,
@for(var method : classDecl.vtable)
    !{String lastName = method.name.toLower();}
    .${dispatchNames.get(method)} =
        &${className}_${dispatchNames.get(method)},
@endfor
};

@if (classDecl.identificator != null)

    int32_t ${classDecl.identificator}(void *data, jobject *buffer);

    JNIEXPORT jint
    ${api.jniName("$" + classDecl.identificator, classDecl.name)}(
        JNIEnv *env, jobject obj, jlong data, jobject ref_buffer
    ) {
        jobject buffer = NULL;
        int32_t id = ${classDecl.identificator}((void *)data, &buffer);
        (*env)->CallVoidMethod(
            env,
            ref_buffer,
            ObjectRef_set_method(env),
            buffer
        );
        return (jint) id;
    }

@endif

@if (classDecl.ownerSetter != null)

    <%-- Java uses different kinds of Reference to handle garbage collection of jobjects
      -- in native calls. We must change to a weak reference when the object is user owned
      -- (the has a reference in the Java world) and delete the previous reference, especially
      -- if it was a GlobalRef. Not removing a Weak only leads to more memory usage, which we
      -- still want to avoid.
      --%>

    void ${classDecl.ownerSetter}(void *data, int32_t owner);
    void *${classDecl.backRefUpdater}(void *data, void *new_ref);

    JNIEXPORT jint
    ${api.jniName("$" + classDecl.ownerSetter, classDecl.name)}(
        JNIEnv *env, jobject obj, jobject self, jlong data, jint owner
    ) {
        ${classDecl.ownerSetter}((void *)data, (int32_t)owner);

        jobject new_ref = NULL;
        if (owner == 1) {
            new_ref = (*env)->NewWeakGlobalRef(env, self);
        } else {
            new_ref = (*env)->NewGlobalRef(env, self);
        }

        jobject old = ${classDecl.backRefUpdater}((void *)data, (void *)new_ref);
        switch ((*env)->GetObjectRefType(env, old)) {
            case JNIGlobalRefType:
                (*env)->DeleteGlobalRef(env, old);
                break;
            case JNIWeakGlobalRefType:
                (*env)->DeleteWeakGlobalRef(env, old);
                break;
        }
    }

@endif

@endif
