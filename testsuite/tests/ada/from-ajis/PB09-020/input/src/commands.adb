package body Commands is

   ---------
   -- Set --
   ---------

   procedure Set (Block : in out Group_Block; Counter : Integer) is
   begin
      Block.Counter := Counter;
   end Set;

   ---------
   -- Get --
   ---------

   function Get (Block : Group_Block) return Integer is
   begin
      return Block.Counter;
   end Get;

end Commands;
