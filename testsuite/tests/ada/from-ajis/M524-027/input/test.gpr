library project Test is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "test";
   for Library_Dir use "lib";
   package Compiler is
      for Default_Switches ("Ada") use ("-g");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;
end Test;
